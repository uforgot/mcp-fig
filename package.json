{
  "name": "mcp-fig",
  "version": "0.0.0",
  "description": "A compact MCP server for structured Figma operations and reliable Auto Layout.",
  "type": "module",
  "private": true,
  "bin": {
    "mcp-fig": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "vitest run tests/quality-gates.test.ts",
    "snapshots:update": "npm run build && node scripts/update-quality-snapshots.mjs && biome format --write tests/snapshots",
    "smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "smoke:plugin": "npm run build && node scripts/smoke-plugin-bridge.mjs",
    "benchmark:live": "node scripts/benchmark-live.mjs",
    "canary:plugin": "npm run build && node scripts/live-plugin-canary.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@figma/plugin-typings": "^1.131.0",
    "@types/node": "^25.0.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
