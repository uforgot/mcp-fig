# Comma-separated optional profiles. core is always enabled.
MCP_FIG_PROFILES=core

# error | warn | info | debug
MCP_FIG_LOG_LEVEL=info

# Optional Figma REST read connection. Provide FIGMA_ACCESS_TOKEN to
# `service install`; the running service does not need it in launchd.
# FIGMA_ACCESS_TOKEN=
# FIGMA_FILE_KEY=
# FIGMA_API_BASE_URL=https://api.figma.com
# FIGMA_REST_TIMEOUT_MS=5000

# Optional live Desktop Plugin bridge. The host always binds to 127.0.0.1.
# Use the same token and port in plugin/ UI when pairing the open Figma file.
# MCP_FIG_PLUGIN_TOKEN=replace-with-a-long-random-token
# MCP_FIG_PLUGIN_PORT=3847
# MCP_FIG_PLUGIN_CLIENT_ID=mcp-fig-local
# MCP_FIG_PLUGIN_FILE_KEY=
