{
  "manifestVersion": "0.1.0-draft",
  "defaultProfile": "core",
  "policies": {
    "actionDiscriminator": "action",
    "unknownFields": "reject",
    "destructiveConfirmation": "confirm must equal target-specific summary token",
    "dryRunDefaultForHighRisk": "true when the action can produce a deterministic preview; raw execute is excluded",
    "resultEnvelope": [
      "ok",
      "tool",
      "action",
      "target",
      "data",
      "changes",
      "warnings",
      "traceId"
    ],
    "errorEnvelope": [
      "ok=false",
      "error.code",
      "error.message",
      "error.retryable",
      "error.details",
      "traceId"
    ]
  },
  "profiles": {
    "core": {
      "default": true,
      "tools": [
        "figma_connection",
        "figma_document",
        "figma_selection",
        "figma_node",
        "figma_layout",
        "figma_component",
        "figma_instance",
        "figma_tokens",
        "figma_styles",
        "figma_screenshot",
        "figma_audit",
        "figma_annotation"
      ],
      "extends": {}
    },
    "tokens": {
      "default": false,
      "tools": [],
      "extends": {
        "figma_tokens": [
          "import",
          "export"
        ]
      }
    },
    "libraries": {
      "default": false,
      "tools": [],
      "extends": {
        "figma_component": [
          "library_search",
          "library_inspect"
        ],
        "figma_tokens": [
          "library_list",
          "library_import"
        ]
      }
    },
    "collaboration": {
      "default": false,
      "tools": [
        "figma_collaboration"
      ],
      "extends": {}
    },
    "history": {
      "default": false,
      "tools": [
        "figma_history"
      ],
      "extends": {}
    },
    "slides": {
      "default": false,
      "tools": [
        "figma_slides"
      ],
      "extends": {}
    },
    "figjam": {
      "default": false,
      "tools": [
        "figma_figjam"
      ],
      "extends": {}
    },
    "debug": {
      "default": false,
      "tools": [],
      "extends": {
        "figma_connection": [
          "logs",
          "watch_logs",
          "clear_logs",
          "reload_plugin"
        ]
      }
    },
    "advanced": {
      "default": false,
      "tools": [
        "figma_execute"
      ],
      "extends": {
        "figma_document": [
          "plugin_view"
        ],
        "figma_audit": [
          "accessibility",
          "design_system",
          "design_code"
        ]
      }
    }
  },
